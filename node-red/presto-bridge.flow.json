    { "id": "debug-lamp-set-raw", "type": "debug", "z": "presto-bridge-tab", "name": "lamp set (raw)", "active": true, "tosidebar": true, "console": false, "tostatus": false, "complete": "true", "targetType": "full", "statusVal": "", "statusType": "auto", "x": 320, "y": 240, "wires": [] },
