    { "id": "debug-ceiling-state-raw", "type": "debug", "z": "presto-bridge-tab", "name": "ceiling state (raw)", "active": true, "tosidebar": true, "console": false, "tostatus": false, "complete": "true", "targetType": "full", "statusVal": "", "statusType": "auto", "x": 420, "y": 300, "wires": [] },
    { "id": "debug-ceiling-state-fn", "type": "debug", "z": "presto-bridge-tab", "name": "ceiling state (transformed)", "active": true, "tosidebar": true, "console": false, "tostatus": false, "complete": "true", "targetType": "full", "statusVal": "", "statusType": "auto", "x": 660, "y": 300, "wires": [] },
    { "id": "debug-ceiling-set-fn", "type": "debug", "z": "presto-bridge-tab", "name": "ceiling set (parsed)", "active": true, "tosidebar": true, "console": false, "tostatus": false, "complete": "true", "targetType": "full", "statusVal": "", "statusType": "auto", "x": 420, "y": 500, "wires": [] },
    { "id": "debug-ceiling-set-switch", "type": "debug", "z": "presto-bridge-tab", "name": "ceiling set (routed on)", "active": true, "tosidebar": true, "console": false, "tostatus": false, "complete": "true", "targetType": "full", "statusVal": "", "statusType": "auto", "x": 620, "y": 500, "wires": [] },
    { "id": "debug-office-state-raw", "type": "debug", "z": "presto-bridge-tab", "name": "office state (raw)", "active": true, "tosidebar": true, "console": false, "tostatus": false, "complete": "true", "targetType": "full", "statusVal": "", "statusType": "auto", "x": 420, "y": 560, "wires": [] },
