[
    {
        "id": "presto-bridge-tab",
        "type": "tab",
        "label": "Presto Dashboard Bridge",
        "disabled": false,
        "info": "Bridges Home Assistant entities to the Presto dashboard's MQTT topic contract (see dashboard/topics.py in the Presto repo).\n\nGOOD NIGHT (presto/scene/good_night) isn't wired up yet -- no scene/script exists in HA for it. Add a state-independent \"MQTT in\" -> \"call service\" pair for it the same way LAMP's /set flow is built, once one exists.\n\nEach server-state-changed node has its Output Properties set to msg.payload = \"Event Data\" (valueType: eventData), i.e. msg.payload = {entity_id, old_state, new_state}, each a full HA state object with .state/.attributes/etc -- confirmed via a raw debug node on switch.example_switch's state-changed node. Two earlier guesses (msg.data.new_state, then a bare top-level msg.state) were both wrong for node-red-contrib-home-assistant-websocket 0.80.3.\n\nceiling-turn-on's Data field must be JSONata \"payload\" (not left blank) -- leaving api-call-service's Data field empty does NOT default to msg.payload in this version; confirmed by brightness commands reaching the node (action fired) but the light not actually dimming until this was set explicitly."
    },
    { "id": "lamp-comment", "type": "comment", "z": "presto-bridge-tab", "name": "LAMP -- switch.example_switch <-> presto/switch/lamp", "x": 260, "y": 60, "wires": [] },

    {
        "id": "lamp-state-in",
        "type": "server-state-changed",
        "z": "presto-bridge-tab",
        "name": "switch.example_switch state changed",
        "server": "c44edbd451c226be",
        "version": 6,
        "outputs": 1,
        "exposeAsEntityConfig": "",
        "entities": { "entity": ["switch.example_switch"], "substring": [], "regex": [] },
        "outputInitially": true,
        "stateType": "str",
        "ifState": "",
        "ifStateType": "str",
        "outputOnlyOnStateChange": false,
        "for": "0",
        "forType": "num",
        "forUnits": "minutes",
        "ignorePrevStateNull": false,
        "ignorePrevStateUnknown": true,
        "ignorePrevStateUnavailable": true,
        "ignoreCurrentStateUnknown": true,
        "ignoreCurrentStateUnavailable": true,
        "outputProperties": [
            { "property": "payload", "propertyType": "msg", "value": "", "valueType": "eventData" }
        ],
        "x": 190, "y": 120, "wires": [["lamp-state-fn", "debug-lamp-state-raw"]]
    },
    {
        "id": "lamp-state-fn",
        "type": "function",
        "z": "presto-bridge-tab",
        "name": "-> {state}",
        "func": "const newState = msg.payload && msg.payload.new_state;\nif (!newState || (newState.state !== 'on' && newState.state !== 'off')) {\n    return null; // skip unknown/unavailable -- don't publish garbage retained state\n}\nmsg.payload = JSON.stringify({ state: newState.state });\nreturn msg;\n",
        "outputs": 1, "timeout": "", "noerr": 0, "initialize": "", "finalize": "", "libs": [],
        "x": 420, "y": 120, "wires": [["lamp-state-out", "debug-lamp-state-fn"]]
    },
    {
        "id": "lamp-state-out",
        "type": "mqtt out",
        "z": "presto-bridge-tab",
        "name": "presto/switch/lamp/state",
        "topic": "presto/switch/lamp/state",
        "qos": "0",
        "retain": "true",
        "respTopic": "", "contentType": "", "userProps": "", "correl": "", "expiry": "",
        "broker": "presto-mqtt-broker",
        "x": 660, "y": 120, "wires": []
    },

    {
        "id": "lamp-set-in",
        "type": "mqtt in",
        "z": "presto-bridge-tab",
        "name": "presto/switch/lamp/set",
        "topic": "presto/switch/lamp/set",
        "qos": "0",
        "datatype": "auto-detect",
        "broker": "presto-mqtt-broker",
        "nl": false, "rap": false, "inputs": 0,
        "x": 190, "y": 200, "wires": [["lamp-set-fn", "debug-lamp-set-raw"]]
    },
    {
        "id": "lamp-set-fn",
        "type": "function",
        "z": "presto-bridge-tab",
        "name": "parse command",
        "func": "let cmd = msg.payload;\nif (typeof cmd === 'string') {\n    try { cmd = JSON.parse(cmd); } catch (e) { return null; }\n}\nif (!cmd || (cmd.state !== 'on' && cmd.state !== 'off')) {\n    return null;\n}\nmsg.payload = cmd;\nreturn msg;",
        "outputs": 1, "noerr": 0, "x": 400, "y": 200, "wires": [["lamp-set-switch", "debug-lamp-set-fn"]]
    },
    {
        "id": "lamp-set-switch",
        "type": "switch",
        "z": "presto-bridge-tab",
        "name": "state?",
        "property": "payload.state",
        "propertyType": "jsonata",
        "rules": [
            { "t": "eq", "v": "on", "vt": "str" },
            { "t": "eq", "v": "off", "vt": "str" }
        ],
        "checkall": "true", "repair": false, "outputs": 2,
        "x": 600, "y": 200, "wires": [["lamp-turn-on"], ["lamp-turn-off"]]
    },
    {
        "id": "lamp-turn-on",
        "type": "api-call-service",
        "z": "presto-bridge-tab",
        "name": "switch.turn_on bookshelf",
        "server": "c44edbd451c226be",
        "version": 7,
        "debugenabled": false,
        "action": "switch.turn_on",
        "floorId": [], "areaId": [], "deviceId": [], "entityId": ["switch.example_switch"], "labelId": [],
        "data": "", "dataType": "json",
        "mergeContext": "", "mustacheAltTags": false,
        "outputProperties": [], "queue": "none", "blockInputOverrides": false,
        "domain": "switch", "service": "turn_on",
        "x": 850, "y": 180, "wires": [[]]
    },
    {
        "id": "lamp-turn-off",
        "type": "api-call-service",
        "z": "presto-bridge-tab",
        "name": "switch.turn_off bookshelf",
        "server": "c44edbd451c226be",
        "version": 7,
        "debugenabled": false,
        "action": "switch.turn_off",
        "floorId": [], "areaId": [], "deviceId": [], "entityId": ["switch.example_switch"], "labelId": [],
        "data": "", "dataType": "json",
        "mergeContext": "", "mustacheAltTags": false,
        "outputProperties": [], "queue": "none", "blockInputOverrides": false,
        "domain": "switch", "service": "turn_off",
        "x": 850, "y": 240, "wires": [[]]
    },

    { "id": "ceiling-comment", "type": "comment", "z": "presto-bridge-tab", "name": "CEILING -- light.example_dimmer <-> presto/light/ceiling", "x": 300, "y": 300, "wires": [] },

    {
        "id": "ceiling-state-in",
        "type": "server-state-changed",
        "z": "presto-bridge-tab",
        "name": "ceiling dimmer state changed",
        "server": "c44edbd451c226be",
        "version": 6,
        "outputs": 1,
        "exposeAsEntityConfig": "",
        "entities": { "entity": ["light.example_dimmer"], "substring": [], "regex": [] },
        "outputInitially": true,
        "stateType": "str",
        "ifState": "",
        "ifStateType": "str",
        "outputOnlyOnStateChange": false,
        "for": "0",
        "forType": "num",
        "forUnits": "minutes",
        "ignorePrevStateNull": false,
        "ignorePrevStateUnknown": true,
        "ignorePrevStateUnavailable": true,
        "ignoreCurrentStateUnknown": true,
        "ignoreCurrentStateUnavailable": true,
        "outputProperties": [
            { "property": "payload", "propertyType": "msg", "value": "", "valueType": "eventData" }
        ],
        "x": 200, "y": 360, "wires": [["ceiling-state-fn", "debug-ceiling-state-raw"]]
    },
    {
        "id": "ceiling-state-fn",
        "type": "function",
        "z": "presto-bridge-tab",
        "name": "-> {state, brightness}",
        "func": "const newState = msg.payload && msg.payload.new_state;\nif (!newState || (newState.state !== 'on' && newState.state !== 'off')) {\n    return null; // skip unknown/unavailable -- don't publish garbage retained state\n}\nconst attrs = newState.attributes || {};\nconst out = { state: newState.state };\nif (typeof attrs.brightness === 'number') {\n    out.brightness = attrs.brightness; // HA's 0-255 brightness matches presto/light's contract directly\n}\nmsg.payload = JSON.stringify(out);\nreturn msg;\n",
        "outputs": 1, "timeout": "", "noerr": 0, "initialize": "", "finalize": "", "libs": [],
        "x": 460, "y": 360, "wires": [["ceiling-state-out", "debug-ceiling-state-fn"]]
    },
    {
        "id": "ceiling-state-out",
        "type": "mqtt out",
        "z": "presto-bridge-tab",
        "name": "presto/light/ceiling/state",
        "topic": "presto/light/ceiling/state",
        "qos": "0",
        "retain": "true",
        "respTopic": "", "contentType": "", "userProps": "", "correl": "", "expiry": "",
        "broker": "presto-mqtt-broker",
        "x": 700, "y": 360, "wires": []
    },

    {
        "id": "ceiling-set-in",
        "type": "mqtt in",
        "z": "presto-bridge-tab",
        "name": "presto/light/ceiling/set",
        "topic": "presto/light/ceiling/set",
        "qos": "0",
        "datatype": "auto-detect",
        "broker": "presto-mqtt-broker",
        "nl": false, "rap": false, "inputs": 0,
        "x": 200, "y": 440, "wires": [["ceiling-set-fn"]]
    },
    {
        "id": "ceiling-set-fn",
        "type": "function",
        "z": "presto-bridge-tab",
        "name": "parse command",
        "func": "let cmd = msg.payload;\nif (typeof cmd === 'string') {\n    try { cmd = JSON.parse(cmd); } catch (e) { return null; }\n}\nif (!cmd || (cmd.state !== 'on' && cmd.state !== 'off')) {\n    return null;\n}\nif (cmd.state === 'off') {\n    msg.topic = 'off';\n    msg.payload = {};\n} else {\n    msg.topic = 'on';\n    msg.payload = (typeof cmd.brightness === 'number') ? { brightness: cmd.brightness } : {};\n}\nreturn msg;",
        "outputs": 1, "noerr": 0, "x": 420, "y": 440, "wires": [["ceiling-set-switch", "debug-ceiling-set-fn"]]
    },
    {
        "id": "ceiling-set-switch",
        "type": "switch",
        "z": "presto-bridge-tab",
        "name": "on/off?",
        "property": "topic",
        "propertyType": "msg",
        "rules": [
            { "t": "eq", "v": "on", "vt": "str" },
            { "t": "eq", "v": "off", "vt": "str" }
        ],
        "checkall": "true", "repair": false, "outputs": 2,
        "x": 620, "y": 440, "wires": [["ceiling-turn-on", "debug-ceiling-set-switch"], ["ceiling-turn-off"]]
    },
    {
        "id": "ceiling-turn-on",
        "type": "api-call-service",
        "z": "presto-bridge-tab",
        "name": "light.turn_on ceiling",
        "server": "c44edbd451c226be",
        "version": 7,
        "debugenabled": false,
        "action": "light.turn_on",
        "floorId": [], "areaId": [], "deviceId": [], "entityId": ["light.example_dimmer"], "labelId": [],
        "data": "payload", "dataType": "jsonata",
        "mergeContext": "", "mustacheAltTags": false,
        "outputProperties": [], "queue": "none", "blockInputOverrides": false,
        "domain": "light", "service": "turn_on",
        "x": 870, "y": 420, "wires": [[]]
    },
    {
        "id": "ceiling-turn-off",
        "type": "api-call-service",
        "z": "presto-bridge-tab",
        "name": "light.turn_off ceiling",
        "server": "c44edbd451c226be",
        "version": 7,
        "debugenabled": false,
        "action": "light.turn_off",
        "floorId": [], "areaId": [], "deviceId": [], "entityId": ["light.example_dimmer"], "labelId": [],
        "data": "", "dataType": "json",
        "mergeContext": "", "mustacheAltTags": false,
        "outputProperties": [], "queue": "none", "blockInputOverrides": false,
        "domain": "light", "service": "turn_off",
        "x": 870, "y": 480, "wires": [[]]
    },

    { "id": "office-comment", "type": "comment", "z": "presto-bridge-tab", "name": "OFFICE -- sensor.example_temperature -> presto/sensor/office_temp (read-only)", "x": 300, "y": 560, "wires": [] },

    {
        "id": "office-state-in",
        "type": "server-state-changed",
        "z": "presto-bridge-tab",
        "name": "office temp sensor state changed",
        "server": "c44edbd451c226be",
        "version": 6,
        "outputs": 1,
        "exposeAsEntityConfig": "",
        "entities": { "entity": ["sensor.example_temperature"], "substring": [], "regex": [] },
        "outputInitially": true,
        "stateType": "str",
        "ifState": "",
        "ifStateType": "str",
        "outputOnlyOnStateChange": false,
        "for": "0",
        "forType": "num",
        "forUnits": "minutes",
        "ignorePrevStateNull": false,
        "ignorePrevStateUnknown": true,
        "ignorePrevStateUnavailable": true,
        "ignoreCurrentStateUnknown": true,
        "ignoreCurrentStateUnavailable": true,
        "outputProperties": [
            { "property": "payload", "propertyType": "msg", "value": "", "valueType": "eventData" }
        ],
        "x": 200, "y": 620, "wires": [["office-state-fn", "debug-office-state-raw"]]
    },
    {
        "id": "office-state-fn",
        "type": "function",
        "z": "presto-bridge-tab",
        "name": "-> {value, unit}",
        "func": "const newState = msg.payload && msg.payload.new_state;\nconst value = newState ? parseFloat(newState.state) : NaN;\nif (Number.isNaN(value)) {\n    return null; // skip unknown/unavailable readings\n}\n// config.py's OFFICE tile hardcodes its displayed unit suffix to \"C\" --\n// if sensor.example_temperature ever reports Fahrenheit, convert here\n// rather than in the firmware.\nmsg.payload = JSON.stringify({ value: value, unit: 'C' });\nreturn msg;\n",
        "outputs": 1, "timeout": "", "noerr": 0, "initialize": "", "finalize": "", "libs": [],
        "x": 460, "y": 620, "wires": [["office-state-out", "debug-office-state-fn"]]
    },
    {
        "id": "office-state-out",
        "type": "mqtt out",
        "z": "presto-bridge-tab",
        "name": "presto/sensor/office_temp/state",
        "topic": "presto/sensor/office_temp/state",
        "qos": "0",
        "retain": "true",
        "respTopic": "", "contentType": "", "userProps": "", "correl": "", "expiry": "",
        "broker": "presto-mqtt-broker",
        "x": 710, "y": 620, "wires": []
    },

    { "id": "debug-lamp-state-raw", "type": "debug", "z": "presto-bridge-tab", "name": "lamp state (raw)", "active": true, "tosidebar": true, "console": false, "tostatus": false, "complete": "true", "targetType": "full", "statusVal": "", "statusType": "auto", "x": 420, "y": 60, "wires": [] },
